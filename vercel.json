{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/newsletter/(.*)", "destination": "/newsletter/$1" },
    { "source": "/data/(.*)", "destination": "/data/$1" }
  ]
}
