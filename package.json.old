{
  "name": "axiom-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "react-app",
    "newsletter"
  ],
  "scripts": {
    "dev": "concurrently \"cd react-app && npm run dev\" \"cd newsletter && npm run dev\"",
    "build:bloom": "node scripts/build-bloom.js",
    "prebuild": "node scripts/build-bloom.js",
    "build": "cd react-app && npm run build && cd ../newsletter && npm run build",
    "postbuild": "node scripts/generate-image-manifest.js && node scripts/optimize-images.mjs && node scripts/postbuild.js && node scripts/make-og-images.mjs && node scripts/generate-pages.js && node -e \"fs.rmSync('react-app/dist-server', {recursive:true, force:true}); fs.rmSync('newsletter/dist', {recursive:true, force:true})\"",
    "preview": "npm run preview --workspace=react-app",
    "lint": "oxlint --ignore-path=.gitignore"
  },
  "devDependencies": {
    "an-array-of-english-words": "^2.0.0",
    "concurrently": "^8.2.2",
    "wordlist-english": "^1.2.1"
  },
  "dependencies": {
    "oxlint": "^1.76.0",
    "sharp": "^0.35.3"
  }
}
