{
  "name": "axiom-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "react-app",
    "newsletter"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=react-app\" \"npm run dev --workspace=newsletter\"",
    "build:bloom": "node scripts/build-bloom.js",
    "prebuild": "node scripts/build-bloom.js",
    "build": "npm run build --workspace=react-app && npm run build --workspace=newsletter",
    "postbuild": "node scripts/generate-image-manifest.js && node scripts/postbuild.js && node scripts/generate-pages.js",
    "preview": "npm run preview --workspace=react-app"
  },
  "devDependencies": {
    "an-array-of-english-words": "^2.0.0",
    "concurrently": "^8.2.2",
    "wordlist-english": "^1.2.1"
  }
}
